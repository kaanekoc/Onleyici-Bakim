@model MachineListViewModel
@{
    ViewData["Title"] = "Makineler";
}

<div class="filter-bar reveal">
    <form method="get" asp-controller="Machines" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label class="form-label small text-muted fw-semibold" for="machineSearch">Makine Ara</label>
            <input id="machineSearch" name="search" value="@Model.Search" class="form-control"
                   placeholder="Makine adı veya kodu" />
        </div>
        <div class="col-lg-2 col-md-6">
            <label class="form-label small text-muted fw-semibold" for="statusFilter">Durum</label>
            <select id="statusFilter" name="status" class="form-select">
                <option value="">Tümü</option>
                @foreach (var status in Model.Statuses)
                {
                    if (Model.SelectedStatus == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-6">
            <label class="form-label small text-muted fw-semibold" for="riskLevelFilter">Risk Seviyesi</label>
            <select id="riskLevelFilter" name="riskLevel" class="form-select">
                <option value="">Tümü</option>
                @foreach (var riskLevel in Model.RiskLevels)
                {
                    if (Model.SelectedRiskLevel == riskLevel)
                    {
                        <option value="@riskLevel" selected>@riskLevel</option>
                    }
                    else
                    {
                        <option value="@riskLevel">@riskLevel</option>
                    }
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-6">
            <label class="form-label small text-muted fw-semibold" for="groupFilter">Grup</label>
            <select id="groupFilter" name="group" class="form-select">
                <option value="">Tümü</option>
                @foreach (var group in Model.Groups)
                {
                    if (Model.SelectedGroup == group)
                    {
                        <option value="@group" selected>@group</option>
                    }
                    else
                    {
                        <option value="@group">@group</option>
                    }
                }
            </select>
        </div>
        <div class="col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-brand flex-grow-1"><i class="bi bi-search"></i> Ara</button>
            <a asp-controller="Machines" asp-action="Index" class="btn btn-primary-soft" title="Filtreleri temizle">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>
    </form>
</div>

<div class="surface-card reveal">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="section-title mb-0"><i class="bi bi-gear-wide-connected"></i> Makine Listesi (@Model.Pagination.TotalCount)</div>
    </div>
    <div class="table-responsive">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Makine Adı</th>
                    <th>Tip</th>
                    <th>Konum</th>
                    <th>Durum</th>
                    <th>Risk Skoru</th>
                    <th>Sonraki Bakım</th>
                    <th>Toplam Arıza</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Machines.Count == 0)
            {
                <tr><td colspan="8" class="text-muted">Filtrelere uyan makine bulunamadı.</td></tr>
            }
            @foreach (var m in Model.Machines)
            {
                var statusPill = m.Status switch
                {
                    "Riskli" => "pill-danger",
                    "İzlemede" => "pill-warn",
                    _ => "pill-ok",
                };
                var riskPill = m.RiskColorKey is "red" or "dark-red" ? "pill-danger" : m.RiskColorKey == "amber" ? "pill-warn" : "pill-ok";
                var barColor = m.RiskColorKey switch { "dark-red" => "#7f1d1d", "red" => "#ef4444", "amber" => "#f59e0b", _ => "#16a34a" };
                <tr class="table-row-link reveal" onclick="location.href='@Url.Action("Details", "Machines", new { id = m.Id })'">
                    <td class="text-muted">@m.Code</td>
                    <td class="fw-semibold">@m.Name</td>
                    <td>@m.Type</td>
                    <td>@m.Location</td>
                    <td><span class="pill @statusPill">@m.Status</span></td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="risk-bar"><span data-width="@m.RiskScore" style="background:@barColor;"></span></div>
                            <span class="pill @riskPill">@m.RiskScore.ToString("0.##") · @m.RiskLevel</span>
                        </div>
                    </td>
                    <td>@m.NextMaintenanceDate.ToString("dd.MM.yyyy")</td>
                    <td>@m.TotalFaultCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model.Pagination" />
</div>
