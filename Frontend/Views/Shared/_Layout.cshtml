@inject IConfiguration Configuration
@{
    var dataMode = Configuration.GetValue<bool>("Backend:UseMockData") ? "Mock Veri Modu" : "SQL Server Veri Modu";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Önleyici Bakım Sistemi</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <span class="brand-mark"><i class="bi bi-cpu-fill"></i></span>
                <div>
                    <div class="brand-title">Önleyici Bakım</div>
                    <div class="brand-subtitle">Sistemi</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> <span>Dashboard</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Machines" ? "active" : "")"
                   asp-controller="Machines" asp-action="Index">
                    <i class="bi bi-gear-wide-connected"></i> <span>Makineler</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Faults" ? "active" : "")"
                   asp-controller="Faults" asp-action="Index">
                    <i class="bi bi-exclamation-triangle-fill"></i> <span>Arıza Geçmişi</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MaintenancePlan" ? "active" : "")"
                   asp-controller="MaintenancePlan" asp-action="Index">
                    <i class="bi bi-calendar2-check-fill"></i> <span>Bakım Planı</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <i class="bi bi-diagram-3"></i>
                <span>ASP.NET Core MVC + Web API</span>
            </div>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <button class="topbar-toggle d-lg-none" id="sidebarToggle" type="button" aria-label="Menüyü aç/kapat">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    <h1 class="topbar-title">@ViewData["Title"]</h1>
                    <p class="topbar-subtitle">Geçmiş arıza verilerine dayalı önleyici bakım takibi</p>
                </div>
                <div class="topbar-spacer"></div>
                <div class="topbar-user">
                    <span class="status-dot"></span>
                    <span>@dataMode</span>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/animations.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
